# FileTools runtime configuration (all optional — sensible defaults are built in)

# App identity
VITE_APP_NAME=FileTools

# Public app URL used for absolute Open Graph URLs (og:url, og:image).
# Set to your production origin. Default: https://filetools.app
VITE_APP_URL=https://filetools.app

# ── Commercial configuration ──────────────────────────────────────────────
# One-time price shown on the upgrade screen (number or string, default 9.99)
VITE_PREMIUM_PRICE=9.99

# ISO 4217 currency code used to format the price (default USD)
VITE_PREMIUM_CURRENCY=USD

# Where the "Upgrade" button sends users. Production default (baked into the
# build) is the store's real Lemon Squeezy checkout — override only if the
# product/variant changes. FileTools never takes payments itself.
VITE_UPGRADE_URL=https://kelvindigitaltools.lemonsqueezy.com/checkout/buy/5a9a0680-dbb4-4c1b-b38c-02c8bbd20fe1

# Premium activation uses Lemon Squeezy license keys delivered to buyers by
# email; the app activates/validates them against the public Lemon Squeezy
# license API at runtime. There is NO static license key here — and never put
# Lemon Squeezy API keys, webhook secrets, or any private payment credential
# in a VITE_* variable (they would ship publicly in the bundle).

# Internal test checkout page, used ONLY in development builds (import.meta.env.DEV).
# Leave unset to use the built-in #/test-checkout page. NEVER sent to users in
# production builds — it is compiled out entirely.
# VITE_TEST_UPGRADE_URL=

# ── Limits ────────────────────────────────────────────────────────────────
# Maximum accepted size per input file, in megabytes (default 50)
VITE_MAX_FILE_MB=50

# Maximum files per Premium batch (default 50)
VITE_MAX_BATCH_FILES=50

# Free-plan limits for the PDF tools (Premium uses VITE_MAX_BATCH_FILES)
VITE_FREE_PDF_IMAGES_LIMIT=5
VITE_FREE_PDF_MERGE_LIMIT=3
