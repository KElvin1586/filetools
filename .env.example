# FileTools runtime configuration (all optional — sensible defaults are built in)

# One-time price shown on the upgrade screen (number or string, default 9.99)
VITE_PREMIUM_PRICE=9.99

# ISO 4217 currency code used to format the price (default USD)
VITE_PREMIUM_CURRENCY=USD

# Where the "Upgrade" button sends users — point this at your real checkout/payment page.
# FileTools never takes payments itself; there are no fake payments.
VITE_UPGRADE_URL=https://example.com/filetools/upgrade

# License key that unlocks Premium in this build. Change it for your own deployment
# and distribute it through your real payment flow. NOTE: this is a client-side app,
# so the key is obfuscation, not security — treat it accordingly.
VITE_PREMIUM_LICENSE_KEY=FILETOOLS-PREMIUM

# Maximum accepted size per input file, in megabytes (default 50)
VITE_MAX_FILE_MB=50
